{
  "name": "ZipViz v1 /verify signature test vectors",
  "format_version": 1,
  "warning": "TEST ONLY. Both keys are derived from published seeds and are not secret. Never register them, trust them, or use them for anything real.",
  "rule": {
    "signed_bytes": "UTF-8 of JSON.stringify({ v: 1, from, message, timestamp }), keys in exactly that order, no whitespace",
    "algorithm": "Ed25519 (RFC 8032), pure, no prehash",
    "signature_encoding": "standard base64 with padding, 64 bytes decoded",
    "public_key_encoding": "lowercase hex, 32 bytes",
    "timestamp_format": "ISO 8601 UTC as produced by Date.prototype.toISOString(), e.g. 2026-10-13T00:00:00.000Z",
    "window_ms": 300000
  },
  "test_keys": {
    "A": {
      "label": "TEST ONLY key A",
      "seed_utf8": "zipviz-v1-verify-TEST-ONLY-key-A",
      "public_key": "7c3a20da2c16a591348196032c38e3d0a2459b2d3d303d5145478220dfd2c9f5"
    },
    "B": {
      "label": "TEST ONLY key B",
      "seed_utf8": "zipviz-v1-verify-TEST-ONLY-key-B",
      "public_key": "4d5dec8d8cfe2a9331cd5a824d9ec5efd672f7ecb82b37e54fbefe5cb5162762"
    }
  },
  "cases": [
    {
      "id": "valid",
      "description": "Correctly signed envelope, 60 seconds old. Byte for byte what `zipviz verify` sends.",
      "public_key": "7c3a20da2c16a591348196032c38e3d0a2459b2d3d303d5145478220dfd2c9f5",
      "now": "2026-10-13T00:01:00.000Z",
      "body": "{\"from\":\"test-alpha-1000.z.viz\",\"message\":\"zipviz-cli key proof 00000000-0000-4000-8000-000000000000\",\"timestamp\":\"2026-10-13T00:00:00.000Z\",\"signature\":\"KtUcns9TFKnEt+cbXGkqSAOrArNkiSbxJLV1Ed1omgi7rglTsgRvtdKpZIgBkHOZZcexJtruZ7hdrqnXWaV0CA==\"}",
      "envelope": {
        "from": "test-alpha-1000.z.viz",
        "message": "zipviz-cli key proof 00000000-0000-4000-8000-000000000000",
        "timestamp": "2026-10-13T00:00:00.000Z",
        "signature": "KtUcns9TFKnEt+cbXGkqSAOrArNkiSbxJLV1Ed1omgi7rglTsgRvtdKpZIgBkHOZZcexJtruZ7hdrqnXWaV0CA=="
      },
      "signed_bytes": "{\"v\":1,\"from\":\"test-alpha-1000.z.viz\",\"message\":\"zipviz-cli key proof 00000000-0000-4000-8000-000000000000\",\"timestamp\":\"2026-10-13T00:00:00.000Z\"}",
      "expected": {
        "verified": true,
        "reason": null
      }
    },
