{
  "name": "zipviz",
  "version": "0.1.0",
  "description": "Agent-native CLI for the ZipViz .viz registry: local Ed25519 keys, invite redemption, verification",
  "license": "Apache-2.0",
  "homepage": "https://github.com/ZipViz/zipviz-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZipViz/zipviz-cli.git"
  },
  "bugs": {
    "url": "https://github.com/ZipViz/zipviz-cli/issues"
  },
  "type": "module",
  "bin": {
    "zipviz": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0"
  }
}
